# Copy to .env and fill in locally. Never commit the real .env.

# LLM provider for the RAG assistant (Session 10 decision). Leave unset to
# run RAG in retrieval-only mode (no LLM call, no key required).
# LLM_PROVIDER=
# LLM_API_KEY=

# MLflow tracking (defaults to local ./mlruns if unset)
# MLFLOW_TRACKING_URI=

# ChromaDB persistence directory (defaults to ./chroma_db if unset)
# CHROMA_PERSIST_DIR=
